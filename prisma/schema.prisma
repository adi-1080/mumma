generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  username        String?          @unique
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  communityPosts  CommunityPost[]
  cookResults     CookResult[]
  cookingSessions CookingSession[]
  accounts        Account[]
  sessions        Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model CookingSession {
  id          String        @id @default(cuid())
  userId      String?
  ingredients Json
  recipeName  String
  recipeDesc  String
  totalSteps  Int
  status      SessionStatus @default(IN_PROGRESS)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  result      CookResult?
  user        User?         @relation(fields: [userId], references: [id])
  steps       CookingStep[]

  @@index([userId])
  @@index([status])
}

model CookingStep {
  id          String         @id @default(cuid())
  sessionId   String
  stepNumber  Int
  title       String
  instruction String
  isCompleted Boolean        @default(false)
  session     CookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chats       StepChat[]

  @@unique([sessionId, stepNumber])
  @@index([sessionId])
}

model StepChat {
  id        String      @id @default(cuid())
  stepId    String
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
  step      CookingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

model CookResult {
  id            String         @id @default(cuid())
  sessionId     String         @unique
  userId        String?
  score         Int
  foodPhotoUrl  String?
  selfieUrl     String?
  isPublished   Boolean        @default(false)
  publishedAt   DateTime?
  recipeName    String
  ingredients   Json
  createdAt     DateTime       @default(now())
  communityPost CommunityPost?
  session       CookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isPublished])
}

model CommunityPost {
  id        String     @id @default(cuid())
  resultId  String     @unique
  userId    String?
  caption   String?
  createdAt DateTime   @default(now())
  result    CookResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum ChatRole {
  USER
  MOM
}
